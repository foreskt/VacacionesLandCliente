{
  "name": "vacacionesland3-mod-sync",
  "version": "0.4.0",
  "private": true,
  "description": "Waza Studios Minecraft launcher for NeoForge and Fabric modpacks",
  "main": "src/client.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "cl.vacacionesland3.launcher",
    "productName": "Waza Studios",
    "publish": [
      {
        "provider": "github",
        "owner": "foreskt",
        "repo": "VacacionesLandCliente",
        "releaseType": "release"
      }
    ],
    "directories": {
      "output": "release"
    },
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "win": {
      "icon": "src/assets/vacacionesland-app.ico",
      "target": "nsis"
    },
    "nsis": {
      "installerIcon": "src/assets/vacacionesland-app.ico",
      "uninstallerIcon": "src/assets/vacacionesland-app.ico",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "electronDist": "node_modules/electron/dist"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "minecraft-java-core": "^4.2.9"
  }
}
